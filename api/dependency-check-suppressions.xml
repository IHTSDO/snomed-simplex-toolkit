<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
	<!--
		False positive: CVE-2026-0994 affects Python google.protobuf.json_format.ParseDict only.
		Dependency-Check maps the CPE to protobuf-java via the shared protobuf product name.
	-->
	<suppress>
		<notes><![CDATA[False positive — Python json_format.ParseDict only, not protobuf-java]]></notes>
		<packageUrl regex="true">^pkg:maven/com\.google\.protobuf/protobuf-java@.*$</packageUrl>
		<cve>CVE-2026-0994</cve>
	</suppress>
	<!--
		False positive: CVE-2026-40981, CVE-2026-40982, CVE-2026-41002, CVE-2026-41004 apply to Spring Cloud Config Server.
		Dependency-Check attaches cpe:vmware:spring_cloud_config to spring-cloud-consul-config and
		spring-cloud-vault-config because they share the Spring Cloud train version; this repo does not
		include spring-cloud-config-server.
	-->
	<suppress>
		<notes><![CDATA[False positive — consul-config client library, not spring-cloud-config-server]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework\.cloud/spring-cloud-consul-config@.*$</packageUrl>
		<cve>CVE-2026-40981</cve>
		<cve>CVE-2026-40982</cve>
		<cve>CVE-2026-41002</cve>
		<cve>CVE-2026-41004</cve>
		<cve>CVE-2026-47894</cve>
		<cve>CVE-2026-59315</cve>
	</suppress>
	<suppress>
		<notes><![CDATA[False positive — vault-config client library, not spring-cloud-config-server]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework\.cloud/spring-cloud-vault-config@.*$</packageUrl>
		<cve>CVE-2026-40981</cve>
		<cve>CVE-2026-40982</cve>
		<cve>CVE-2026-41002</cve>
		<cve>CVE-2026-41004</cve>
		<cve>CVE-2026-47894</cve>
		<cve>CVE-2026-59315</cve>
	</suppress>
	<suppress>
		<notes><![CDATA[False positive — starter wraps consul-config client, not config-server]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework\.cloud/spring-cloud-starter-consul-config@.*$</packageUrl>
		<cve>CVE-2026-40981</cve>
		<cve>CVE-2026-40982</cve>
		<cve>CVE-2026-41002</cve>
		<cve>CVE-2026-41004</cve>
		<cve>CVE-2026-47894</cve>
		<cve>CVE-2026-59315</cve>
	</suppress>
	<suppress>
		<notes><![CDATA[False positive — starter wraps vault-config client, not config-server]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework\.cloud/spring-cloud-starter-vault-config@.*$</packageUrl>
		<cve>CVE-2026-40981</cve>
		<cve>CVE-2026-40982</cve>
		<cve>CVE-2026-41002</cve>
		<cve>CVE-2026-41004</cve>
		<cve>CVE-2026-47894</cve>
		<cve>CVE-2026-59315</cve>
	</suppress>
	<!--
		False positive: CVE-2026-54285 affects @opentelemetry/javascript (W3CBaggagePropagator), not opentelemetry-java.
	-->
	<suppress>
		<notes><![CDATA[False positive — OpenTelemetry JavaScript client CVE, not opentelemetry-java]]></notes>
		<packageUrl regex="true">^pkg:maven/io\.opentelemetry/opentelemetry-(api|context|sdk|exporter).*@.*$</packageUrl>
		<cve>CVE-2026-54285</cve>
	</suppress>
	<!--
		False positive: CVE-2026-54399 and CVE-2026-54428 affect org.apache.httpcomponents.core5:httpcore5 only.
		Dependency-Check maps the shared CPE apache:httpcomponents_core onto the legacy 4.x httpcore artifact.
	-->
	<suppress>
		<notes><![CDATA[False positive — CVEs apply to httpcore5 (5.x), not legacy httpcore 4.x line]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents/httpcore(-nio)?@.*$</packageUrl>
		<cve>CVE-2026-54399</cve>
		<cve>CVE-2026-54428</cve>
	</suppress>
	<!--
		CVE-2026-66299 affects the WebSocket chat example in Tomcat's examples webapp only.
		Spring Boot embedded Tomcat does not ship that application.
	-->
	<suppress>
		<notes><![CDATA[Not applicable — embedded Tomcat without examples webapp]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat-embed-(core|websocket)@.*$</packageUrl>
		<cve>CVE-2026-66299</cve>
	</suppress>
	<!--
		CVE-2026-59313 affects Spring MVC functional web framework SSE endpoints only.
		This application uses annotation-based controllers and does not expose SSE.
	-->
	<suppress>
		<notes><![CDATA[Not applicable — no functional web framework or SSE endpoints]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework/.*@.*$</packageUrl>
		<cve>CVE-2026-59313</cve>
	</suppress>
	<!--
		CVE-2026-47892 affects WebFlux functional endpoint CORS pre-flight authorization only.
		CVE-2026-47893 affects Spring WebSocket handshake error handling only.
		This application uses annotation-based MVC and does not expose WebFlux or WebSocket endpoints.
	-->
	<suppress>
		<notes><![CDATA[Not applicable — annotation-based MVC only, no WebFlux or WebSocket]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework/.*@.*$</packageUrl>
		<cve>CVE-2026-47892</cve>
		<cve>CVE-2026-47893</cve>
	</suppress>
	<!--
		CVE-2026-59280 affects FreeMarker view resolution via SpringTemplateLoader only.
		This application does not use FreeMarker templates.
	-->
	<suppress>
		<notes><![CDATA[Not applicable — no FreeMarker integration]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework/.*@.*$</packageUrl>
		<cve>CVE-2026-59280</cve>
	</suppress>
	<!--
		CVE-2026-59314 affects Content-Disposition built from untrusted input when the connector
		does not reject CRLF. Embedded Tomcat (default) already rejects such characters per Spring advisory.
	-->
	<suppress>
		<notes><![CDATA[Not applicable — embedded Tomcat rejects CRLF in response headers]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework/.*@.*$</packageUrl>
		<cve>CVE-2026-59314</cve>
	</suppress>
	<!--
		CVE-2026-59283 is fixed in Spring Framework 6.2.20 (enterprise-only, not on Maven Central)
		or 7.0.9 (requires Spring Boot 4). Suppress until Spring Boot 4 migration is feasible.
	-->
	<suppress>
		<notes><![CDATA[No OSS fix on Maven Central for Spring Boot 3.x line; requires Spring Boot 4 / Spring 7.0.9]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework/.*@.*$</packageUrl>
		<cve>CVE-2026-59283</cve>
	</suppress>
	<!--
		CVE-2026-59270 affects Spring Security embedded UnboundID LDAP (UnboundIdContainer) only.
		This application uses IMS SSO and does not run an embedded LDAP server.
	-->
	<suppress>
		<notes><![CDATA[Not applicable — no embedded UnboundID LDAP server]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.springframework\.security/.*@.*$</packageUrl>
		<cve>CVE-2026-59270</cve>
	</suppress>
</suppressions>
