<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<name>SNOMED Simplex Toolkit</name>
	<description>Toolkit for the creation and maintenance of simple SNOMED CT Extensions</description>

	<parent>
		<groupId>org.snomed</groupId>
		<artifactId>snomed-parent-bom</artifactId>
		<version>3.14.1</version>
	</parent>

	<groupId>org.snomed.simplex</groupId>
	<artifactId>snomed-simplex-toolkit-parent</artifactId>
	<version>3.1.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<properties>
		<!-- snomed-parent-bom property overrides. Remove and reassert when upgrading the BOM. -->
		<activemq.version>6.2.8</activemq.version>
		<tomcat-embed.version>10.1.57</tomcat-embed.version>
		<spring.version>6.2.19</spring.version>
		<spring-boot.version>3.5.15</spring-boot.version>
		<spring.security.version>6.5.11</spring.security.version>
		<poi.version>5.4.1</poi.version>
		<gson.version>2.13.2</gson.version>
		<jackson.version>2.18.9</jackson.version>
		<elasticsearch.version>8.19.19</elasticsearch.version>
		<log4j.version>2.25.5</log4j.version>
		<commons-lang3.version>3.20.0</commons-lang3.version>
		<httpcore5.version>5.4.3</httpcore5.version>

		<!-- Application-specific versions -->
		<langchain4j.version>1.4.0</langchain4j.version>
		<jackson3.version>3.1.5</jackson3.version>
		<swagger-ui.version>5.32.11</swagger-ui.version>
		<springdoc.version>2.8.17</springdoc.version>
		<opentelemetry.version>1.62.0</opentelemetry.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Explicit pins: snomed-parent-bom hardcodes versions or Spring Boot import ignores property overrides -->
			<!-- tomcat-embed-el is managed by Spring Boot (${tomcat.version}), not snomed BOM (${tomcat-embed.version}) -->
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-el</artifactId>
				<version>${tomcat-embed.version}</version>
			</dependency>
			<dependency>
				<groupId>org.elasticsearch.client</groupId>
				<artifactId>elasticsearch-rest-client</artifactId>
				<version>${elasticsearch.version}</version>
			</dependency>
			<dependency>
				<groupId>org.elasticsearch.client</groupId>
				<artifactId>elasticsearch-rest-client-sniffer</artifactId>
				<version>${elasticsearch.version}</version>
			</dependency>
			<!-- Spring Boot BOM pins these with hardcoded versions; property overrides alone do not apply -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-lang3</artifactId>
				<version>${commons-lang3.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.httpcomponents.core5</groupId>
				<artifactId>httpcore5</artifactId>
				<version>${httpcore5.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.httpcomponents.core5</groupId>
				<artifactId>httpcore5-h2</artifactId>
				<version>${httpcore5.version}</version>
			</dependency>
			<!-- snomed-parent-bom pins springdoc at 2.6.0 -->
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
			<dependency>
				<groupId>io.opentelemetry</groupId>
				<artifactId>opentelemetry-api</artifactId>
				<version>${opentelemetry.version}</version>
			</dependency>
			<dependency>
				<groupId>org.webjars</groupId>
				<artifactId>swagger-ui</artifactId>
				<version>${swagger-ui.version}</version>
			</dependency>
			<dependency>
				<groupId>tools.jackson.core</groupId>
				<artifactId>jackson-core</artifactId>
				<version>${jackson3.version}</version>
			</dependency>
			<dependency>
				<groupId>tools.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>${jackson3.version}</version>
			</dependency>
			<dependency>
				<groupId>dev.langchain4j</groupId>
				<artifactId>langchain4j-core</artifactId>
				<version>${langchain4j.version}</version>
			</dependency>
			<dependency>
				<groupId>dev.langchain4j</groupId>
				<artifactId>langchain4j-open-ai</artifactId>
				<version>${langchain4j.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<modules>
		<module>angular-ui</module>
		<module>api</module>
	</modules>

	<build>
		<plugins>
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<inherited>false</inherited>
				<configuration>
					<nvdApiKey>${nvdApiKey}</nvdApiKey>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>update-only</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<repositories>
		<repository>
			<id>ihtsdo-releases</id>
			<name>ihtsdo-releases</name>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<url>https://nexus3.ihtsdotools.org/repository/maven-releases/</url>
		</repository>
		<repository>
			<id>ihtsdo-snapshots</id>
			<name>ihtsdo-snapshots</name>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
			<url>https://nexus3.ihtsdotools.org/repository/maven-snapshots/</url>
		</repository>
        <repository>
            <id>repository.spring.release</id>
            <name>Spring GA Repository</name>
            <url>http://repo.spring.io/release</url>
        </repository>
	</repositories>

	<distributionManagement>
		<repository>
			<id>ihtsdo-public-nexus</id>
			<name>IHTSDO Public Nexus Releases</name>
			<url>https://maven.ihtsdotools.org/content/repositories/releases/</url>
		</repository>
		<snapshotRepository>
			<id>ihtsdo-public-nexus</id>
			<name>IHTSDO Public Nexus Snapshots</name>
			<url>https://maven.ihtsdotools.org/content/repositories/snapshots/</url>
		</snapshotRepository>
	</distributionManagement>

</project>
